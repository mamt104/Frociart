<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0-windows</TargetFramework>

    <UseWindowsForms>true</UseWindowsForms>

    <UseWPF>true</UseWPF>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Frociart</AssemblyName>

    <RootNamespace>Frociart</RootNamespace>

    <StartupObject>Frociart.Program</StartupObject>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <ImplicitUsings>disable</ImplicitUsings>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <Nullable>disable</Nullable>

    <ApplicationManifest>app-modern.manifest</ApplicationManifest>

    <ApplicationIcon>Frociart.ico</ApplicationIcon>

    <SelfContained>true</SelfContained>

    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>

    <PublishSingleFile>true</PublishSingleFile>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>false</PublishTrimmed>

    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>embedded</DebugType>

    <DebugSymbols>true</DebugSymbols>

    <Deterministic>true</Deterministic>

    <PathMap>$(MSBuildProjectDirectory)=/_/Frociart,$(MSBuildProjectExtensionsPath)=/_/Frociart/obj</PathMap>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>


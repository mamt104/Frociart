<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="it.frociart.app.continua" android:versionCode="105" android:versionName="v1">

  <uses-permission android:name="android.permission.VIBRATE" />

  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

  <application android:label="Frociart" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/FrociartTheme" android:allowBackup="false" android:supportsRtl="true" android:hardwareAccelerated="true" android:usesCleartextTraffic="false">

    <activity android:name="it.frociart.app.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|uiMode" android:windowSoftInputMode="adjustResize">

      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>

      <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="content"/><data android:mimeType="application/x-frociart"/></intent-filter>

    </activity>

    <provider android:name="it.frociart.app.ShareProvider" android:authorities="it.frociart.app.continua.files" android:exported="false" android:grantUriPermissions="true"/>

  </application>

</manifest>





